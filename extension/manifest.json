{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.2.0",
  "description": "Autofill job applications from your CV \u2014 and tailor it per job with your Claude session.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JobPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}